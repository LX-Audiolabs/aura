// Vertical level meter (display-only). Material 3 dark tokens.

import { AuraTheme } from "theme.slint";

export component Meter inherits Rectangle {
    in property <float> level-left: 0.0;
    in property <float> level-right: 0.0;

    min-width: 16px;
    max-width: 16px;
    preferred-width: 16px;
    preferred-height: 100px;

    HorizontalLayout {
        padding: 0px;
        spacing: 2px;

        Rectangle {
            background: AuraTheme.surface-container-highest;
            border-radius: AuraTheme.radius-xs;
            clip: true;

            property <float> lv: clamp(root.level-left, 0, 1);
            Rectangle {
                y: parent.height * (1.0 - lv);
                height: parent.height * lv;
                background: lv > 0.95 ? AuraTheme.error : AuraTheme.primary;
                border-radius: AuraTheme.radius-xs;
            }
        }

        Rectangle {
            background: AuraTheme.surface-container-highest;
            border-radius: AuraTheme.radius-xs;
            clip: true;

            property <float> rv: clamp(root.level-right, 0, 1);
            Rectangle {
                y: parent.height * (1.0 - rv);
                height: parent.height * rv;
                background: rv > 0.95 ? AuraTheme.error : AuraTheme.primary;
                border-radius: AuraTheme.radius-xs;
            }
        }
    }
}
