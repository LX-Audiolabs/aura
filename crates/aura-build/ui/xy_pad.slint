// XY pad — 2D control. Material 3 dark surface + primary accent.

import { AuraTheme } from "theme.slint";

export component XYPad inherits VerticalLayout {
    in-out property <float> value-x: 0.5;
    in-out property <float> value-y: 0.5;
    in property <string> label: "";

    callback changed-x(float);
    callback changed-y(float);

    min-width: 80px;
    min-height: 90px;
    preferred-width: 120px;
    preferred-height: 132px;
    spacing: 4px;

    pad := Rectangle {
        vertical-stretch: 1;
        background: AuraTheme.surface-container-high;
        border-color: AuraTheme.outline-variant;
        border-width: 1px;
        border-radius: AuraTheme.radius-sm;

        property <length> dot-x: pad.width * root.value-x;
        property <length> dot-y: pad.height * (1.0 - root.value-y);

        Rectangle {
            x: pad.dot-x - 0.5px;
            y: 0px;
            width: 1px;
            height: pad.height;
            background: AuraTheme.primary.with-alpha(0.35);
        }
        Rectangle {
            x: 0px;
            y: pad.dot-y - 0.5px;
            width: pad.width;
            height: 1px;
            background: AuraTheme.primary.with-alpha(0.35);
        }

        Rectangle {
            x: pad.dot-x - 6px;
            y: pad.dot-y - 6px;
            width: 12px;
            height: 12px;
            border-radius: AuraTheme.radius-full;
            background: AuraTheme.primary;
        }

        touch := TouchArea {
            width: pad.width;
            height: pad.height;

            moved => {
                if self.pressed {
                    root.value-x = clamp(touch.mouse-x / pad.width, 0.0, 1.0);
                    root.value-y = clamp(1.0 - touch.mouse-y / pad.height, 0.0, 1.0);
                    root.changed-x(root.value-x);
                    root.changed-y(root.value-y);
                }
            }

            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    root.value-x = clamp(touch.mouse-x / pad.width, 0.0, 1.0);
                    root.value-y = clamp(1.0 - touch.mouse-y / pad.height, 0.0, 1.0);
                    root.changed-x(root.value-x);
                    root.changed-y(root.value-y);
                }
            }
        }
    }

    Text {
        text: root.label;
        font-size: AuraTheme.font-label;
        color: AuraTheme.on-surface-variant;
        horizontal-alignment: center;
    }
}
