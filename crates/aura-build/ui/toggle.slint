// On/off toggle switch with label.

import { Switch } from "std-widgets.slint";
import { AuraTheme } from "theme.slint";

export component Toggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> label: "";
    in property <color> label-color: AuraTheme.on-surface-variant;

    callback toggled(bool);

    width: 64px;
    height: 52px;
    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 4px;

        Switch {
            checked <=> root.checked;
            toggled => { root.toggled(root.checked); }
        }

        Text {
            text: root.label;
            font-size: AuraTheme.font-label;
            color: root.label-color;
            horizontal-alignment: center;
        }
    }
}
