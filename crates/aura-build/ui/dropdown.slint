// Click-to-open dropdown bound to an integer-index parameter.

import { ComboBox } from "std-widgets.slint";
import { AuraTheme } from "theme.slint";

export component Dropdown inherits Rectangle {
    in-out property <int> index: 0;
    in property <[string]> options: [];
    in property <string> label: "";

    in property <color> label-color: AuraTheme.on-surface-variant;

    callback changed(int);

    width: 128px;
    height: 52px;
    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 4px;

        ComboBox {
            model: root.options;
            current-index <=> root.index;
            selected => { root.changed(root.index); }
        }

        Text {
            text: root.label;
            font-size: AuraTheme.font-label;
            color: root.label-color;
            horizontal-alignment: center;
        }
    }
}
