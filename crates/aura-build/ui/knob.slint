// Rotary knob with 270-degree arc, pointer, and hover ring.
// Colors default to Material 3 dark tokens via AuraTheme.

import { AuraTheme } from "theme.slint";

export component Knob inherits Rectangle {
    in-out property <float> value: 0.5;
    in property <string> label: "";
    in property <string> value-text: "";
    in property <float> minimum: 0.0;
    in property <float> maximum: 1.0;

    in property <color> track-color: AuraTheme.outline-variant;
    in property <color> fill-color: AuraTheme.primary;
    in property <color> pointer-color: AuraTheme.on-surface;
    in property <color> hover-color: AuraTheme.primary;
    in property <color> label-color: AuraTheme.on-surface-variant;
    in property <color> value-color: AuraTheme.on-surface;

    callback changed(float);

    width: 64px;
    height: 88px;
    background: transparent;

    property <float> norm: (value - minimum) / (maximum - minimum);
    property <float> val-angle: 135 + norm * 270;

    pure function ax(a: float) -> float { 32 + 26 * cos(a * 1deg) }
    pure function ay(a: float) -> float { 32 + 26 * sin(a * 1deg) }
    pure function ptr-len() -> float { 26 * 0.55 }

    // Soft surface under the arc (M3 container)
    Rectangle {
        x: (parent.width - 64px) / 2;
        y: 2px;
        width: 64px;
        height: 64px;
        border-radius: AuraTheme.radius-full;
        background: AuraTheme.surface-container-high;
    }

    // Hover ring
    Path {
        x: (parent.width - 64px) / 2;
        y: 2px;
        width: 64px;
        height: 64px;
        viewbox-x: 0; viewbox-y: 0;
        viewbox-width: 64; viewbox-height: 64;
        stroke: touch.has-hover ? root.hover-color : transparent;
        stroke-width: 1.5px;

        MoveTo { x: 32 + 30 * cos(135deg); y: 32 + 30 * sin(135deg); }
        ArcTo {
            x: 32 + 30 * cos(405deg); y: 32 + 30 * sin(405deg);
            radius-x: 30; radius-y: 30;
            sweep: true; large-arc: true;
        }
    }

    // Track
    Path {
        x: (parent.width - 64px) / 2;
        y: 2px;
        width: 64px;
        height: 64px;
        viewbox-x: 0; viewbox-y: 0;
        viewbox-width: 64; viewbox-height: 64;
        stroke: root.track-color;
        stroke-width: 3.5px;

        MoveTo { x: ax(135); y: ay(135); }
        ArcTo {
            x: ax(405); y: ay(405);
            radius-x: 26; radius-y: 26;
            sweep: true; large-arc: true;
        }
    }

    // Value arc
    Path {
        x: (parent.width - 64px) / 2;
        y: 2px;
        width: 64px;
        height: 64px;
        viewbox-x: 0; viewbox-y: 0;
        viewbox-width: 64; viewbox-height: 64;
        stroke: root.fill-color;
        stroke-width: 3.5px;

        MoveTo { x: ax(135); y: ay(135); }
        ArcTo {
            x: ax(root.val-angle); y: ay(root.val-angle);
            radius-x: 26; radius-y: 26;
            sweep: true;
            large-arc: root.norm > 0.667;
        }
    }

    // Pointer
    Path {
        x: (parent.width - 64px) / 2;
        y: 2px;
        width: 64px;
        height: 64px;
        viewbox-x: 0; viewbox-y: 0;
        viewbox-width: 64; viewbox-height: 64;
        stroke: root.pointer-color;
        stroke-width: 2px;

        MoveTo { x: 32; y: 32; }
        LineTo {
            x: 32 + ptr-len() * cos(root.val-angle * 1deg);
            y: 32 + ptr-len() * sin(root.val-angle * 1deg);
        }
    }

    // Center cap
    Rectangle {
        x: (parent.width - 10px) / 2;
        y: 2px + 27px;
        width: 10px;
        height: 10px;
        border-radius: AuraTheme.radius-full;
        background: AuraTheme.primary-container;
    }

    Text {
        y: 62px;
        width: parent.width;
        text: root.value-text != "" ? root.value-text : round(root.value * 100) / 100;
        font-size: AuraTheme.font-value;
        font-weight: 500;
        color: root.value-color;
        horizontal-alignment: center;
    }

    Text {
        y: 76px;
        width: parent.width;
        text: root.label;
        font-size: AuraTheme.font-label;
        color: root.label-color;
        horizontal-alignment: center;
    }

    touch := TouchArea {
        width: parent.width;
        height: 68px;
        property <float> start-value;

        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                start-value = root.value;
            }
        }
        moved => {
            if self.pressed {
                root.value = clamp(
                    start-value - (touch.mouse-y - touch.pressed-y) / 150px * (root.maximum - root.minimum),
                    root.minimum, root.maximum,
                );
                root.changed(root.value);
            }
        }
    }
}
