{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Berlin",
  "dependencyDashboard": true,
  "prConcurrentLimit": 8,
  "cargo": {
    "enabled": true,
    "addLabels": ["dependencies", "rust"]
  },
  "github-actions": {
    "enabled": false
  },
  "rust-toolchain": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["slint", "slint-build", "slint-interpreter"],
      "groupName": "slint"
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["clap-sys", "clap"],
      "groupName": "clap"
    }
  ]
}
