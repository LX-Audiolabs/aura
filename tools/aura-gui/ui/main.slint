// AURA project console — sugar over `cargo aura` (CLI remains source of truth).
import { Button, CheckBox, LineEdit, ScrollView } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "AURA";
    preferred-width: 720px;
    preferred-height: 560px;
    min-width: 560px;
    min-height: 420px;
    background: #121218;

    in-out property <string> project-dir: ".";
    in-out property <string> plugin-name: "my-plugin";
    // 0 = effect, 1 = effect-mono, 2 = analyzer
    in-out property <int> kind-index: 0;
    in-out property <bool> format-clap: true;
    in-out property <bool> format-vst3: false;
    in-out property <bool> format-lv2: false;
    in-out property <bool> release-build: true;
    in-out property <bool> busy: false;
    in-out property <string> log-text: "AURA gui — same actions as `cargo aura …`\n";

    callback run-new();
    callback run-init();
    callback run-add();
    callback run-build();
    callback run-install();
    callback run-doctor();
    callback clear-log();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "AURA";
                color: #e8e8f0;
                font-size: 22px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                text: "project console  ·  CLI parity";
                color: #8888a0;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.busy: Text {
                text: "working…";
                color: #7aa2ff;
                font-size: 13px;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 1px;
            background: #2a2a38;
        }

        VerticalLayout {
            spacing: 4px;
            Text {
                text: "Project directory";
                color: #a0a0b8;
                font-size: 12px;
            }
            LineEdit {
                text <=> root.project-dir;
                placeholder-text: "path for add/build/install (new creates subdir here)";
                enabled: !root.busy;
            }
        }

        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: "Plugin name";
                    color: #a0a0b8;
                    font-size: 12px;
                }
                LineEdit {
                    text <=> root.plugin-name;
                    placeholder-text: "my-plugin";
                    enabled: !root.busy;
                }
            }
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Kind";
                    color: #a0a0b8;
                    font-size: 12px;
                }
                HorizontalLayout {
                    spacing: 6px;
                    Button {
                        text: "effect";
                        enabled: !root.busy;
                        primary: root.kind-index == 0;
                        clicked => { root.kind-index = 0; }
                    }
                    Button {
                        text: "mono";
                        enabled: !root.busy;
                        primary: root.kind-index == 1;
                        clicked => { root.kind-index = 1; }
                    }
                    Button {
                        text: "analyzer";
                        enabled: !root.busy;
                        primary: root.kind-index == 2;
                        clicked => { root.kind-index = 2; }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            Text {
                text: "Formats";
                color: #a0a0b8;
                font-size: 12px;
                vertical-alignment: center;
            }
            CheckBox {
                text: "CLAP";
                checked <=> root.format-clap;
                enabled: !root.busy;
            }
            CheckBox {
                text: "VST3";
                checked <=> root.format-vst3;
                enabled: !root.busy;
            }
            CheckBox {
                text: "LV2";
                checked <=> root.format-lv2;
                enabled: !root.busy;
            }
            CheckBox {
                text: "release";
                checked <=> root.release-build;
                enabled: !root.busy;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
        }

        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "New";
                enabled: !root.busy;
                primary: true;
                clicked => { root.run-new(); }
            }
            Button {
                text: "Init";
                enabled: !root.busy;
                clicked => { root.run-init(); }
            }
            Button {
                text: "Add plugin";
                enabled: !root.busy;
                clicked => { root.run-add(); }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
        }

        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "Build";
                enabled: !root.busy;
                clicked => { root.run-build(); }
            }
            Button {
                text: "Install";
                enabled: !root.busy;
                clicked => { root.run-install(); }
            }
            Button {
                text: "Doctor";
                enabled: !root.busy;
                clicked => { root.run-doctor(); }
            }
            Button {
                text: "Clear log";
                enabled: !root.busy;
                clicked => { root.clear-log(); }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
        }

        Text {
            text: "Maps to: cargo aura new|init|add|build|install|doctor  (same flags)";
            color: #606078;
            font-size: 11px;
        }

        Rectangle {
            background: #0c0c12;
            border-radius: 6px;
            border-width: 1px;
            border-color: #2a2a38;
            vertical-stretch: 1;

            ScrollView {
                vertical-stretch: 1;
                viewport-width: parent.width - 8px;
                Text {
                    width: parent.width - 20px;
                    padding: 10px;
                    text: root.log-text;
                    color: #c8c8d8;
                    font-family: "Consolas";
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }
    }
}
